{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|static/|favicon.ico|robots.txt|sitemap.xml).*\\.[a-zA-Z0-9]+)$",
      "destination": "/404"
    },
    {
      "source": "/((?!assets/|static/|favicon.ico|robots.txt|sitemap.xml).*)$",
      "destination": "/index.html"
    }
  ]
}
