# Environment configuration
ENVIRONMENT=development

# Database connection string for Supabase/PostgreSQL
DATABASE_URL=postgresql://[user].[project-id]:[password]@[host]:6543/postgres

# Ingestion Settings
GITHUB_USERNAME=your_github_username
GITHUB_PAT=ghp_YourPersonalAccessTokenHere
MEDIUM_USERNAME=your_medium_username
DEVTO_USERNAME=your_devto_username

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_strong_password
JWT_SECRET_KEY=super-secret-stackecho-key-change-this-in-prod
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Admin Workspace Toggle
# Set to "false" on resource-constrained hosts (e.g. Render Free tier) to disable
# heavy admin operations (CV generation, scraping, LinkedIn import) and avoid OOM crashes.
# Admin work can then be done locally against the same database.
ENABLE_ADMIN_WORKSPACE=true

# Cron Jobs Toggle
# Set to "false" on resource-constrained hosts to disable the nightly data sync scheduler.
# Data ingestion can then be triggered manually via the admin panel on your local machine.
ENABLE_CRON_JOBS=true

# Web Concurency
WEB_CONCURRENCY=1

# Supabase Configurations
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key

# LLM Provider Setup
# Options: mock, openai, groq, ollama
LLM_PROVIDER=mock

# OpenAI Settings
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o

# Groq Settings
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Settings
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://resumesh-frontend.vercel.app

# PostHog Telemetry
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Reactive Resume Settings (https://rxresu.me)
REACTIVE_RESUME_URL=https://rxresu.me
REACTIVE_RESUME_API_KEY=
