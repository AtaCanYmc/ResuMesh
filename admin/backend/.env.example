# Environment configuration
ENVIRONMENT=development
# SECRET_KEY=generate_a_secure_random_key_here

# Active Database Provider (local-postgres, mongodb, firebase, supabase)
DB_PROVIDER=local-postgres
LOG_DB_PROVIDER=mongodb
DATABASE_URL=postgresql://portfolio_user:portfolio_password@localhost:5432/portfolio_db

# Ingestion Settings
GITHUB_USERNAME=your_github_username
GITHUB_PAT=ghp_YourPersonalAccessTokenHere
MEDIUM_USERNAME=your_medium_username
DEVTO_USERNAME=your_devto_username

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_strong_password
JWT_SECRET_KEY=super-secret-stackecho-key-change-this-in-prod

# Admin Workspace Toggle
# Set to "false" on resource-constrained hosts (e.g. Render Free tier) to disable
# heavy admin operations (CV generation, scraping, LinkedIn import) and avoid OOM crashes.
# Admin work can then be done locally against the same database.
ENABLE_ADMIN_WORKSPACE=true

# Cron Jobs Toggle
# Set to "false" on resource-constrained hosts to disable the nightly data sync scheduler.
# Data ingestion can then be triggered manually via the admin panel on your local machine.
ENABLE_CRON_JOBS=true

# Web Concurency
WEB_CONCURRENCY=1

# LLM Provider Setup
# Options: mock, openai, groq, ollama
LLM_PROVIDER=mock

# OpenAI Settings
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Groq Settings
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama3-70b-8192

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# PostgreSQL Connection Strings
POSTGRE_URL=postgresql://postgres:resumesh_dev_password_987@localhost:5432/resumesh

# MongoDB Connection Strings
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=resumesh

# Supabase Configurations
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key

# Firebase Configurations
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://resumesh-frontend.vercel.app

# PostHog Telemetry (optional in development)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Reactive Resume Settings (https://rxresu.me)
REACTIVE_RESUME_URL=http://localhost:3000
REACTIVE_RESUME_API_KEY=your_reactive_resume_api_key_here
